{
  "name": "team-okr-tracker",
  "private": true,
  "version": "1.1.0",
  "description": "Team OKR Tracker (PRD v1.1): goals, standup, approvals, reviews, leave, hiring, onboarding and email alerts. No third-party dependencies.",
  "type": "module",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server.js",
    "setup-link": "node --disable-warning=ExperimentalWarning server.js setup-link",
    "reset-link": "node --disable-warning=ExperimentalWarning server.js reset-link",
    "backup": "node --disable-warning=ExperimentalWarning server.js backup",
    "test": "node --disable-warning=ExperimentalWarning --test"
  }
}
